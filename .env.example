# The install's .env starts as a copy of this (stack/install.sh); fill it in there.
# Compose reads .env from the install's root.

# Container user. 1000 = dario, 1001 = media — the library is already dario:media,
# so running as these means no media file ever needs a chown.
PUID=1000
PGID=1001

TZ=America/Argentina/Buenos_Aires

# Container config/state. Must be on / — /mnt/data is nearly full (98%), and Plex
# metadata plus transcode scratch would eat what little is left.
APPDATA=/opt/appdata

# ── Fresh install only ────────────────────────────────────────────────────────

# From https://plex.tv/claim. Valid for 4 minutes, and only read when plex starts
# with an empty /config. Leave empty on a box whose Plex config already exists.
PLEX_CLAIM=

# ── jobs/pms-update/update-stack.sh (pms-update.timer) ────────────────────────

# Compose services the weekly update covers, space-separated. Add each service
# as its phase brings it up. plex is skipped while it is not running.
UPDATE_SERVICES=plex qbittorrent prowlarr flaresolverr radarr sonarr seerr bazarr docs

# Seconds a recreated container gets to come back healthy before it is rolled
# back to the previous image.
UPDATE_HEALTH_WAIT=180

# ── qBittorrent for the arrs (:8081) ──────────────────────────────────────────

# WebUI login of the container instance — not native qbittorrent-nox's. The
# first `task qbittorrent:configure` sets it, using the temporary password the
# container prints on first start. Radarr and Sonarr use it from Phase 4.
QBT_ARR_USER=
QBT_ARR_PASS=

# ── Prowlarr (:9696) ──────────────────────────────────────────────────────────

# API key, fixed before the first start (compose passes it as
# PROWLARR__AUTH__APIKEY). 32 hex characters: openssl rand -hex 16
# Radarr and Sonarr use it from Phase 4.
PROWLARR_API_KEY=

# WebUI login. Not asked from the LAN; set by `task prowlarr:configure`.
PROWLARR_USER=
PROWLARR_PASS=

# ── Radarr (:7878) + Sonarr (:8989) ───────────────────────────────────────────

# API keys, fixed before the first start (compose passes them as
# <APP>__AUTH__APIKEY). 32 hex characters each: openssl rand -hex 16
# Prowlarr pushes its indexers to both with them; arr-reclaim reads their
# import history with them.
RADARR_API_KEY=
SONARR_API_KEY=

# One WebUI login for both. Not asked from the LAN; set by `task arr:configure`.
ARR_USER=
ARR_PASS=

# Plex token for their Plex connection (library refresh on import). The same
# one pms-local uses: sudo grep ^PLEX_TOKEN= /etc/plex-move.conf
PLEX_TOKEN=

# ── Bazarr (:6767) ────────────────────────────────────────────────────────────

# Optional OpenSubtitles.com account (free: ~20 downloads a day) — the largest
# catalogue. Without it Bazarr uses only providers that need no account.
# Its WebUI login is ARR_USER/ARR_PASS; its API key is its own (config.yaml).
OPENSUBTITLES_USER=
OPENSUBTITLES_PASS=

# ── jobs/stack-api: Ask AI on /requests/ ──────────────────────────────────────

# The models the page may ask, comma-separated provider/model; the page picks
# among them, and stack-api refuses any other. "off" turns Ask AI off. Unset:
# ollama/qwen2.5:3b. Only ollama has a client so far (native ollama.service,
# outside compose); a model must be pulled first: ollama pull <model>.
# Read when stack-api starts: sudo systemctl restart stack-api after a change.
AI_MODELS=ollama/qwen2.5:3b,ollama/llama3.2,ollama/mistral
# The one asked unless the page picks another (one of AI_MODELS; else the first).
AI_MODEL=ollama/qwen2.5:3b
# Where Ollama answers. Empty: http://127.0.0.1:11434.
OLLAMA_URL=
# Answers an hour, every model together. Empty: 20.
AI_MAX_PER_HOUR=20
