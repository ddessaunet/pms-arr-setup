---
// The login page's panel: one button, and a line that says what happened.
// Its script (lib/login-client.ts) enables the button once it knows stack-api
// is up; without JavaScript there is no sign-in, as there is no Plex popup.
---

<section class="login" aria-labelledby="login-head">
  <p class="login-ghost" aria-hidden="true"></p>
  <h2 id="login-head" class="login-head">Owner only</h2>
  <p>
    This site shows the media server's state and controls it. Sign in with the Plex account that owns the server.
  </p>
  <button type="button" class="ctl-btn" data-login disabled>Sign in with Plex</button>
  <p class="login-msg" data-login-msg role="status" aria-live="polite"></p>
</section>

<script>
  import '../lib/login-client.ts';
</script>
