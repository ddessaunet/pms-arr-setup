# stack-status.service — one fast run of jobs/stack-status/stack-status.sh.
#
# Source of truth is this file; `task deploy` installs it with its timer.
#
#   journalctl -u stack-status
#
# @PMS_HOME@ and @PMS_USER@ are filled in by stack/install.sh: ExecStart points
# into the install, because the script reads .env and the apps' configure
# helpers beside it.

[Unit]
Description=Write the stack's status and recent logs for the docs site's front and logs pages
Documentation=https://github.com/ddessaunet/pms-arr-setup/blob/main/jobs/stack-status/README.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=@PMS_HOME@/jobs/stack-status/stack-status.sh

# Not root: it reads the apps' APIs with the keys from the install's .env, docker
# (the installing user is in the docker group) and the journal (adm group).
User=@PMS_USER@
Group=@PMS_GROUP@

# Usually a few seconds: the probes run in parallel, each request is capped at
# 5 s and each docker/systemctl/journalctl call at 10 s.
TimeoutStartSec=2min

NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
# AF_NETLINK: `ip -j addr` reads the LAN addresses through netlink.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

Nice=10
IOSchedulingClass=idle
