# arr-fallback-search.service — one run of jobs/arr-fallback-search/arr-fallback-search.sh.
#
# Source of truth is this file; `task deploy` installs it with its timer.
#
#   journalctl -u arr-fallback-search
#
# @PMS_HOME@ and @PMS_USER@ are filled in by stack/install.sh: ExecStart points
# into the install, because the script reads .env beside it.

[Unit]
Description=Search Radarr again for "4K HDR or 1080p" movies without a 4K file
Documentation=https://github.com/ddessaunet/pms-arr-setup/blob/main/docs/phases.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=@PMS_HOME@/jobs/arr-fallback-search/arr-fallback-search.sh

# Not root: it only talks to Radarr's API, with the key from the install's .env.
User=@PMS_USER@
Group=@PMS_GROUP@

# It queues one command and returns; Radarr does the searching.
TimeoutStartSec=5min

NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

Nice=10
IOSchedulingClass=idle
