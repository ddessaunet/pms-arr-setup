# stack-api.service — the docs site's backend: the Plex sign-in, request status
# and Ask AI (Ollama on 127.0.0.1:11434).
#
# Source of truth is this file. `task deploy`
# installs it, enables it and restarts it; `task deploy:check` reports drift.
#
#   systemctl status stack-api
#   journalctl -u stack-api -f
#
# It listens on /opt/appdata/stack-api/run/api.sock, which apps/docs mounts and
# nginx proxies /api/ to. nginx also asks it before serving any page: while
# this is down, the site shows only its login page.

[Unit]
Description=Docs site backend: Plex sign-in and request status (a Unix socket for nginx)
Documentation=https://github.com/ddessaunet/pms-arr-setup/blob/main/jobs/stack-api/README.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# Runs from the install (.env beside it); stack/install.sh fills in @PMS_HOME@
# and @PMS_USER@, and deploy.sh refuses a mismatched path.
ExecStart=@PMS_HOME@/jobs/stack-api/stack-api.sh

# Not root: it reads the apps' APIs and plex.tv, and writes only its own
# folder under /opt/appdata/stack-api, which the installing user owns.
User=@PMS_USER@
Group=@PMS_GROUP@

# A crash should not lock the site for long. RestartSec keeps a persistent
# failure from spinning.
Restart=always
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Its socket, the apps and Ollama on 127.0.0.1, and plex.tv.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

Nice=5

[Install]
WantedBy=multi-user.target
