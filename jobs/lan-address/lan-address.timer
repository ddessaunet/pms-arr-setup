# lan-address.timer — after every boot, then every 5 minutes.
#
# Source of truth is this file.
#   sudo systemctl enable --now lan-address.timer
#   systemctl list-timers lan-address.timer
#
# The box's address is reserved on the router, but the old router's DHCP moved
# it on reboots, and a lost reservation or a new router would again. A run with
# no change reads the addresses, compares them with /opt/appdata/.lan-address
# and stops, so every 5 minutes costs nothing.

[Unit]
Description=Check the box's LAN addresses after boot and every 5 minutes

[Timer]
# Two minutes gives DHCP and the containers time to come up; an app that is
# still starting fails its configure and is retried on the next run.
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s

[Install]
WantedBy=timers.target
