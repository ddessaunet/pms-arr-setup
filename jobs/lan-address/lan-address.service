# lan-address.service — one run of jobs/lan-address/lan-address.sh.
#
# Source of truth is this file; `task deploy` installs it with its timer.
#
#   journalctl -u lan-address
#
# @PMS_HOME@ and @PMS_USER@ are filled in by stack/install.sh: ExecStart points
# into the install, because the script reads .env and the apps' configure.sh
# beside it.

[Unit]
Description=Apply the apps' settings again when the box's LAN addresses change
Documentation=https://github.com/ddessaunet/pms-arr-setup/blob/main/jobs/lan-address/README.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=@PMS_HOME@/jobs/lan-address/lan-address.sh

# Not root: the configure scripts only talk to the apps' APIs, with the keys from
# the install's .env (Seerr's from /opt/appdata/seerr, which that user owns).
User=@PMS_USER@
Group=@PMS_GROUP@

# Usually seconds. After an address change it runs five configure scripts, and
# Prowlarr's waits up to 90 s for its indexer sync and restarts the app.
TimeoutStartSec=15min

NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
# AF_NETLINK: listing the interfaces' addresses (stack/lib/net.ts) takes netlink.
# Without it the script sees no address and does nothing, every time.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

Nice=10
IOSchedulingClass=idle
